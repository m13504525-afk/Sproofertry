local function ValidateKey(keyText)
    local success, response = pcall(function()
        local requestData = HttpService:JSONEncode({
            key = keyText,
            hwid = tostring(LocalPlayer.UserId)
        })
        
        local req = (syn and syn.request) or (http and http.request) or http_request or request
        if not req then
            error("Executor HTTP request function not available.")
        end
        
        local res = req({
            Url = "https://nmdsjfnjoxexrkkyevtg.supabase.co/functions/v1/check-key",
            Method = "POST",
            Headers = {
                ["Content-Type"] = "application/json"
            },
            Body = requestData
        })
        
        if res and res.Body then
            return HttpService:JSONDecode(res.Body)
        end
        return nil
    end)
    
    if success and response then
        return response
    end
    return {success = false, message = "Connection error or invalid response."}
end

