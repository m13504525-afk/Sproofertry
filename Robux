LaunchEliteHubDashboard = function(verifiedKeyText)
    local player = LocalPlayer

    -- Persistent Data Management (Save/Load Robux across re-opens)
    local saveFileName = "EliteHub_RobuxWallet.json"
    local globalWalletRobux = 1000000

    local success, savedData = pcall(function()
        if readfile and isfile and isfile(saveFileName) then
            return HttpService:JSONDecode(readfile(saveFileName))
        end
    end)

    if success and savedData and savedData.robux then
        globalWalletRobux = tonumber(savedData.robux) or 1000000
    else
        globalWalletRobux = 1000000
    end

    local function saveWalletData()
        pcall(function()
            if writefile then
                writefile(saveFileName, HttpService:JSONEncode({robux = globalWalletRobux}))
            end
        end)
    end

    -- Helper function to parse Robux from text
    local function parseRobux(inputStr)
        if type(inputStr) == "number" then return inputStr end
        local cleanStr = tostring(inputStr):gsub("[,%s]", ""):upper()
        local multiplier = 1
        
        if cleanStr:find("B") then
            multiplier = 1000000000
            cleanStr = cleanStr:gsub("B", "")
        elseif cleanStr:find("M") then
            multiplier = 1000000
            cleanStr = cleanStr:gsub("M", "")
        elseif cleanStr:find("K") then
            multiplier = 1000
            cleanStr = cleanStr:gsub("K", "")
        end
        
        local num = tonumber(cleanStr)
        if not num then return 0 end
        return math.floor(num * multiplier)
    end

    -- Helper function to format Robux (K, M, B)
    local function formatRobux(num)
        if type(num) == "string" then num = parseRobux(num) end
        
        if num >= 1000000000 then
            return string.format("%.1fB", num / 1000000000):gsub("%.0", "")
        elseif num >= 1000000 then
            return string.format("%.1fM", num / 1000000):gsub("%.0", "")
        elseif num >= 1000 then
            return string.format("%.1fK", num / 1000):gsub("%.0", "")
        else
            return tostring(num)
        end
    end

    -- Delta compatible secure thumbnail fetcher
    local function getPlayerThumbnail(username)
        if username == "" or not username then
            return ""
        end
        
        local success, userId = pcall(function()
            return Players:GetUserIdFromNameAsync(username)
        end)
        
        if not success or not userId then
            return ""
        end
        
        local thumbSuccess, thumbUrl = pcall(function()
            return Players:GetUserThumbnailAsync(userId, Enum.ThumbnailType.HeadShot, Enum.ThumbnailSize.Size420x420)
        end)
        
        if thumbSuccess and thumbUrl then
            return thumbUrl
        else
            return ""
        end
    end

    -- Make frame draggable
    local function makeDraggable(frame)
        local dragging, dragInput, dragStart, startPos

        frame.InputBegan:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragging = true
                dragStart = input.Position
                startPos = frame.Position
                
                input.Changed:Connect(function()
                    if input.UserInputState == Enum.UserInputState.End then
                        dragging = false
                    end
                end)
            end
        end)

        frame.InputChanged:Connect(function(input)
            if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
                dragInput = input
            end
        end)

        UserInputService.InputChanged:Connect(function(input)
            if input == dragInput and dragging then
                local delta = input.Position - dragStart
                frame.Position = UDim2.new(
                    startPos.X.Scale, 
                    startPos.X.Offset + delta.X, 
                    startPos.Y.Scale, 
                    startPos.Y.Offset + delta.Y
                )
            end
        end)
    end

    -- 3D world particle effect
    local function playWorldParticleEffect()
        local character = player.Character
        if not character or not character:FindFirstChild("HumanoidRootPart") then return end
        local rootPart = character.HumanoidRootPart

        local attachment = Instance.new("Attachment")
        attachment.Name = "RobuxBurstAttachment"
        attachment.Parent = rootPart

        local emitter = Instance.new("ParticleEmitter")
        emitter.Name = "RobuxParticles"
        emitter.Texture = "rbxasset://textures/ui/common/robux@3x.png"
        emitter.Rate = 0
        emitter.Speed = NumberRange.new(8, 16)
        emitter.Size = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.2, 2.6),
            NumberSequenceKeypoint.new(0.8, 2.6),
            NumberSequenceKeypoint.new(1, 0)
        })
        emitter.Lifetime = NumberRange.new(2.5, 3.5)
        emitter.Transparency = NumberSequence.new({
            NumberSequenceKeypoint.new(0, 0),
            NumberSequenceKeypoint.new(0.6, 0.1),
            NumberSequenceKeypoint.new(1, 1)
        })
        emitter.EmissionDirection = Enum.NormalId.Top
        emitter.SpreadAngle = Vector2.new(180, 180)
        emitter.Acceleration = Vector3.new(0, -6, 0)
        emitter.Parent = attachment

        emitter:Emit(18)

        task.delay(4, function()
            if attachment then
                attachment:Destroy()
            end
        end)
    end

    -- Roblox tarzı üst bildirim fonksiyonu (Sadece Robux yetmeme durumu için)
    local function showRobloxNotification(message)
        if CoreGui:FindFirstChild("RobloxNotificationGui") then
            CoreGui.RobloxNotificationGui:Destroy()
        end

        local notifGui = Instance.new("ScreenGui")
        notifGui.Name = "RobloxNotificationGui"
        notifGui.IgnoreGuiInset = true
        notifGui.Parent = CoreGui

